{%- capture simpleTextData -%}
content:
    text: {{ text | stringifyFilter }}
styles:
    alignX: {{ alignX | default: "start" }}
    size: {{ size | default: "default" }}
{%- endcapture -%}
{%- assign simpleTextObj = simpleTextData | ymlify -%}
{% capture output %}{% bookshop "building-blocks/core-elements/simple-text" bind: simpleTextObj %}{% endcapture %}
{%- comment -%} roseyStrip: a snippet sits inside an already-tagged rich-text region. {%- endcomment -%}
{{ output | roseyStrip | removeExtraWhitespace | strip }}

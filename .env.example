# Copy to .env for local development. .env is gitignored.

# Rosey internationalization.
# Off by default. When "true":
#   - components emit data-rosey attributes during the Eleventy build
#   - `npm run rosey` translates dist/ after the build
# Locales are configured in rosey/rcc.yaml (empty list ships by default).
ROSEY_ENABLED=false
